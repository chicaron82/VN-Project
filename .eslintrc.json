{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "prefer-const": "error",
        "no-var": "error",
        "eqeqeq": "warn",
        "curly": "warn",
        "no-multi-spaces": "warn",
        "no-trailing-spaces": "warn",
        "semi": [
            "error",
            "always"
        ],
        "quotes": [
            "warn",
            "single",
            {
                "avoidEscape": true
            }
        ],
        "indent": [
            "warn",
            4
        ],
        "no-multiple-empty-lines": [
            "warn",
            {
                "max": 2
            }
        ]
    },
    "ignorePatterns": [
        "node_modules/",
        "dist/",
        "*.min.js"
    ]
}