{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting - STRICT MODE */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    
    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@core/*": ["./v2/core/*"],
      "@systems/*": ["./v2/systems/*"],
      "@controllers/*": ["./v2/controllers/*"],
      "@ui/*": ["./v2/ui/*"],
      "@content/*": ["./v2/content/*"],
      "@utils/*": ["./v2/utils/*"]
    }
  },
  "include": ["v2/**/*"],
  "exclude": ["node_modules", "dist", "v2-temp", "v2/**/*.test.ts", "v2/tests/**/*"]
}
