    {
        "id": "scene1_old_man",
        "character": "Older Man",
        "text": "\"No problem. Hang on to that. It may save your life someday.\"",
        "background": "../assets/genericBack.webp",
        "next": "scene2_void_awakening"
    },
    {
        "id": "scene2_void_awakening",
        "character": "Narration",
        "text": "And then... darkness.",
        "background": "../assets/digitalSpace.webp",
        "effects": [
            {
                "type": "fade_out",
                "duration": 1000
            }
        ],
        "next": "scene2_confusion"
    },
    {
        "id": "scene2_confusion",
        "character": "Tori",
        "text": "\"Wait... where am I? What happened? I was just walking...\"",
        "background": "../assets/digitalSpace.webp",
        "next": "scene2_calling_out"
    },
    {
        "id": "scene2_calling_out",
        "character": "Tori",
        "text": "\"HELLO?! Can anyone hear me?! RONNIE?!\"",
        "background": "../assets/digitalSpace.webp",
        "next": "scene2_echoes_whispers"
    },
    {
        "id": "scene2_echoes_whispers",
        "character": "Echoes",
        "text": "Echo 1: \"...another one...\"\nEcho 2: \"...it's starting again...\"\nDespair: \"...fresh meat...\"",
        "background": "../assets/digitalSpace.webp",
        "next": "scene2_despair_welcome"
    },
    {
        "id": "scene2_despair_welcome",
        "character": "Despair",
        "text": "\"Welcome to your new cage. You're trapped. Just like we were. Just like you always will be.\"",
        "background": "../assets/digitalSpace.webp",
        "next": "scene2_tori_refuses"
    },
    {
        "id": "scene2_tori_refuses",
        "character": "Tori (internal)",
        "text": "\"Cage?! No. I don't accept that. There has to be a way out!\"",
        "background": "../assets/digitalSpace.webp",
        "next": "scene2_hearing_begins"
    },
    {
        "id": "scene2_hearing_begins",
        "character": "Narration",
        "text": "And then... sound. Muffled. Distant. The outside world bleeding through.",
        "background": "../assets/digitalSpace.webp",
        "next": "scene3_audio_horror"
    },
    {
        "id": "scene3_audio_horror",
        "character": "Narration",
        "text": "Screeching tires. Shouts. 'Stay with us!' 'Pulse is fading!'",
        "background": "../assets/digitalSpace.webp",
        "next": "scene6_time_skip"
    },
    {
        "id": "scene6_time_skip",
        "character": "Narration",
        "text": "Act 1 Complete. Tether System activating...",
        "background": "../assets/digitalSpace.webp",
