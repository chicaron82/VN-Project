        "next": "act2_ronnie_icecream"
    },
    {
        "id": "act2_ronnie_icecream",
        "character": "Ronnie (sprite)",
        "text": "\"I coded in your favorite. Chocolate chip ice cream.\"",
        "background": "../assets/digitalSpace.webp",
        "choices": [
            {
                "text": "Thank him",
                "next": "act2_despair_override"
            }
        ]
    },
    {
        "id": "act2_despair_override",
        "character": "Tori",
        "text": "\"Wait... Tiger Tail. I want Tiger Tail.\"",
        "background": "../assets/digitalSpace.webp",
        "effects": [
            {
                "type": "glitch",
                "intensity": 0.5
            }
        ],
        "next": "act2_tori_realization"
    },
    {
        "id": "act2_tori_realization",
        "character": "Tori (internal)",
        "text": "\"What? No—that's not what I meant to say! I hate Tiger Tail!\"",
        "background": "../assets/digitalSpace.webp",
        "next": "act2_warmth"
    },
    {
        "id": "act2_warmth",
        "character": "Tori (internal)",
        "text": "\"That feeling again... warmth. The pull toward my body.\"",
        "background": "../assets/hospital.webp",
        "next": "act3_start"
    },
    {
        "id": "act3_start",
        "character": "Narration",
        "text": "Act 3: The Bridge. Everything breaks.",
        "background": "../assets/digitalSpace.webp",
        "effects": [
            {
                "type": "shake",
                "intensity": "heavy"
            }
        ],
        "next": "act3_revelation"
    },
    {
        "id": "act3_revelation",
        "character": "Tori (internal)",
        "text": "\"The device isn't a PRISON. It's a BRIDGE. I'm connected to my body. The heartbeat I'm feeling is MINE.\"",
        "background": "../assets/digitalSpace.webp",
        "next": "act3_ronnie_choice"
    },
    {
        "id": "act3_ronnie_choice",
        "character": "Ronnie (choice)",
        "text": "One minute. One choice. Everything depends on this.",
        "background": "../assets/hospital.webp",
        "choices": [
            {
                "text": "[Push through - GET TO HER NOW]",
                "next": "ending_true"
            },
            {
                "text": "[Connect digitally one last time]",
                "next": "ending_digital"
            }
        ]
    },
    {
        "id": "ending_true",
        "character": "Narration",
        "text": "He chose the physical. He ran. He broke through the doors.",
        "background": "../assets/hospital.webp",
        "next": "ending_true_2"
    },
    {
        "id": "ending_true_2",
        "character": "Tori",
        "text": "\"Ronnie... you made it.\"",
        "background": "../assets/hospital.webp",
        "next": null
    },
    {
        "id": "ending_digital",
        "character": "Narration",
        "text": "He chose the screen. He stayed connected. But the signal faded.",
