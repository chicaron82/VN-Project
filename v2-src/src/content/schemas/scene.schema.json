{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uv7.game/schemas/scene.json",
  "title": "UV7 Scene",
  "description": "A scene in the UV7 visual novel",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique scene identifier",
      "pattern": "^[a-z0-9-]+$"
    },
    "background": {
      "type": "string",
      "description": "Background image ID"
    },
    "music": {
      "type": "string",
      "description": "Background music ID"
    },
    "sprites": {
      "type": "array",
      "description": "Character sprites to display",
      "items": {
        "$ref": "#/definitions/SpriteConfig"
      }
    },
    "dialog": {
      "type": "array",
      "description": "Dialog entries for this scene",
      "items": {
        "$ref": "#/definitions/DialogEntry"
      }
    },
    "choices": {
      "type": "array",
      "description": "Player choices",
      "items": {
        "$ref": "#/definitions/Choice"
      }
    },
    "effects": {
      "type": "array",
      "description": "Visual effects to apply",
      "items": {
        "$ref": "#/definitions/Effect"
      }
    },
    "tetherImpact": {
      "type": "number",
      "description": "How much to adjust tether when entering scene"
    },
    "next": {
      "oneOf": [
        {
          "type": "string",
          "description": "ID of next scene"
        },
        {
          "$ref": "#/definitions/ConditionalNext"
        }
      ]
    },
    "flags": {
      "type": "array",
      "description": "Flags to set when entering scene",
      "items": {
        "$ref": "#/definitions/FlagChange"
      }
    },
    "counters": {
      "type": "array",
      "description": "Counters to modify when entering scene",
      "items": {
        "$ref": "#/definitions/CounterChange"
      }
    },
    "unlockNote": {
      "type": "string",
      "description": "Note ID to unlock when entering scene"
    },
    "unlockAchievement": {
      "type": "string",
      "description": "Achievement ID to unlock when entering scene"
    }
  },
  "definitions": {
    "CharacterId": {
      "type": "string",
      "enum": ["ronnie", "tori", "kai", "echo", "player"]
    },
    "Emotion": {
      "type": "string",
      "enum": ["neutral", "happy", "sad", "angry", "surprised", "worried", "smirk", "blush", "hurt", "determined"]
    },
    "SpriteConfig": {
      "type": "object",
      "required": ["character", "emotion", "position"],
      "properties": {
        "character": {
          "$ref": "#/definitions/CharacterId"
        },
        "emotion": {
          "$ref": "#/definitions/Emotion"
        },
        "position": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "flip": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "DialogEntry": {
      "type": "object",
      "required": ["speaker", "text"],
      "properties": {
        "speaker": {
          "oneOf": [
            { "$ref": "#/definitions/CharacterId" },
            { "type": "string", "const": "narrator" }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "emotion": {
          "$ref": "#/definitions/Emotion"
        },
        "sound": {
          "type": "string",
          "description": "Sound effect to play"
        }
      }
    },
    "Condition": {
      "type": "object",
      "properties": {
        "flag": {
          "type": "string",
          "description": "Flag that must be true"
        },
        "counter": {
          "type": "object",
          "required": ["name", "comparison", "value"],
          "properties": {
            "name": { "type": "string" },
            "comparison": { "type": "string", "enum": ["gte", "lte", "eq"] },
            "value": { "type": "number" }
          }
        },
        "tether": {
          "type": "object",
          "required": ["comparison", "value"],
          "properties": {
            "comparison": { "type": "string", "enum": ["gte", "lte", "eq"] },
            "value": { "type": "number" }
          }
        }
      }
    },
    "FlagChange": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string", "const": "toggle" }
          ]
        }
      }
    },
    "CounterChange": {
      "type": "object",
      "required": ["name", "operation", "value"],
      "properties": {
        "name": { "type": "string" },
        "operation": { "type": "string", "enum": ["set", "add", "subtract"] },
        "value": { "type": "number" }
      }
    },
    "Choice": {
      "type": "object",
      "required": ["text", "next"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "string",
          "description": "Scene ID to go to when selected"
        },
        "condition": {
          "$ref": "#/definitions/Condition",
          "description": "Condition for this choice to be visible"
        },
        "tetherCost": {
          "type": "number",
          "description": "Tether change when selected (negative = cost)"
        },
        "flags": {
          "type": "array",
          "items": { "$ref": "#/definitions/FlagChange" }
        },
        "counters": {
          "type": "array",
          "items": { "$ref": "#/definitions/CounterChange" }
        }
      }
    },
    "Effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["glitch", "fade", "shake", "flash", "static", "vhs", "redpulse", "tetherdrain"]
        },
        "duration": {
          "type": "number",
          "description": "Duration in milliseconds"
        },
        "intensity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "ConditionalNext": {
      "type": "object",
      "required": ["conditions", "default"],
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "sceneId"],
            "properties": {
              "condition": { "$ref": "#/definitions/Condition" },
              "sceneId": { "type": "string" }
            }
          }
        },
        "default": {
          "type": "string",
          "description": "Default scene if no conditions match"
        }
      }
    }
  }
}
