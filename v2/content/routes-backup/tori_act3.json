{
    "scenes": [
        {
            "id": "beat2",
            "type": "dialog",
            "character": "Narration",
            "text": "Pixel kitchen. Cooking memory. But something\\'s... off.",
            "nextSceneId": "beat2_argument",
            "internal": "[Visual: The same scene from Act 2. But corrupted. Colors bleeding.]",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat2_argument",
            "type": "dialog",
            "character": "Ronnie (sprite)",
            "text": "\"You burned the garlic bread again.\"",
            "nextSceneId": "beat2_toriResponse",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "right"
            }
        },
        {
            "id": "beat2_toriResponse",
            "type": "dialog",
            "character": "Tori (sprite, voice not hers)",
            "text": "\"I hate you.\"",
            "nextSceneId": "beat2_horror",
            "internal": "[NO. That\\'s not what I said. I said \"shut up\" as a JOKE.]",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat2_horror",
            "type": "dialog",
            "character": "Tori (internal, panicking)",
            "text": "\"The memory is WRONG. That\\'s not how it happened. Why is it playing wrong?!\"",
            "nextSceneId": "beat2_echoes",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat2_echoes",
            "type": "dialog",
            "character": "Echoes",
            "text": "Echo 2: \"Memory corruption.\"\\nEcho 1: \"The system is rewriting her.\"\\nDespair: \"Soon you won\\'t remember what was real and what the code invented.\"",
            "nextSceneId": "beat2_ronnieNotice",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat2_ronnieNotice",
            "type": "dialog",
            "character": "Ronnie (concerned)",
            "text": "\"Tori? You okay? You just... froze.\"",
            "nextSceneId": "beat2_choice",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "right"
            }
        },
        {
            "id": "beat2_choice",
            "type": "dialog",
            "character": "Tori",
            "text": "\"Do I tell him the memory played wrong? Or pretend it\\'s fine?\"",
            "nextSceneId": null,
            "choices": [
                {
                    "text": "[Tell him: \"The memory was corrupted\"]",
                    "value": "truth",
                    "nextSceneId": "beat2_truth"
                },
                {
                    "text": "[Lie: \"I'm fine, just tired\"]",
                    "value": "lie",
                    "nextSceneId": "beat2_lie"
                },
                {
                    "text": "[Deflect: Change the subject]",
                    "value": "deflect",
                    "nextSceneId": "beat2_deflect"
                }
            ],
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            },
            "isInternal": true
        },
        {
            "id": "beat2_truth",
            "type": "dialog",
            "character": "Tori (typing)",
            "text": "\"That memory... it didn\\'t play right. The words were wrong.\"",
            "nextSceneId": "beat3",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat2_lie",
            "type": "dialog",
            "character": "Tori (typing)",
            "text": "\"I\\'m fine. Just a glitch. Keep going.\"",
            "nextSceneId": "beat3",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat2_deflect",
            "type": "dialog",
            "character": "Tori (typing)",
            "text": "\"Let\\'s do something else. Anything else.\"",
            "nextSceneId": "beat3",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat3",
            "type": "dialog",
            "character": "Narration",
            "text": "Text boxes appear. In her vision. Overlaying everything.",
            "nextSceneId": "beat3_firstBox",
            "internal": "[Visual: System UI elements appearing where they shouldn\\'t. Debug console bleeding through.]",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat3_firstBox",
            "type": "dialog",
            "character": "System",
            "text": "[Battery: 15%]",
            "nextSceneId": "beat3_toriReact",
            "internal": "[She SEES it. Not as UI. As part of her reality.]",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat3_toriReact",
            "type": "dialog",
            "character": "Tori",
            "text": "\"What is that? Why am I seeing system messages?\"",
            "nextSceneId": "beat3_moreBoxes",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            },
            "isInternal": true
        },
        {
            "id": "beat3_moreBoxes",
            "type": "dialog",
            "character": "System",
            "text": "[Warning: Fragmentation detected]\\n[Memory corruption: 67%]\\n[Connection unstable]",
            "nextSceneId": "beat3_horror",
            "internal": "[The boxes multiply. Fill her vision. She can barely see Ronnie anymore.]",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat3_horror",
            "type": "dialog",
            "character": "Tori (internal, breaking)",
            "text": "\"I\\'m seeing the backend. The debug console. Because I\\'m not separate from the system. I AM the system.\"",
            "nextSceneId": "beat3_echoes",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat3_echoes",
            "type": "dialog",
            "character": "Echoes",
            "text": "Echo 1: \"Now she understands.\"\\nEcho 2: \"She\\'s not trapped IN code.\"\\nDespair: \"She IS code. And code doesn\\'t have a soul to save.\"",
            "nextSceneId": "beat3_truthBox",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat3_truthBox",
            "type": "dialog",
            "character": "System",
            "text": "[You can\\'t upload a soul.]",
            "nextSceneId": "beat3_choice",
            "internal": "[That\\'s not a system message. That\\'s a TRUTH. Hard-coded. A rule.]",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat3_choice",
            "type": "dialog",
            "character": "Tori",
            "text": "\"Do I fight this? Or accept what I am?\"",
            "nextSceneId": null,
            "choices": [
                {
                    "text": "[Fight: \"I'm MORE than code\"]",
                    "value": "fight",
                    "nextSceneId": "beat3_fight"
                },
                {
                    "text": "[Accept: \"Maybe I am just data\"]",
                    "value": "accept",
                    "nextSceneId": "beat3_accept"
                },
                {
                    "text": "[Question: \"What IS a soul?\"]",
                    "value": "question",
                    "nextSceneId": "beat3_question"
                }
            ],
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            },
            "isInternal": true
        },
        {
            "id": "beat3_fight",
            "type": "dialog",
            "character": "Tori (internal, defiant)",
            "text": "\"No. I\\'m MORE than code. I have to be.\"",
            "nextSceneId": "beat4",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat3_accept",
            "type": "dialog",
            "character": "Tori (internal, hollow)",
            "text": "\"Maybe I\\'m just... data. And data ends.\"",
            "nextSceneId": "beat4",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat3_question",
            "type": "dialog",
            "character": "Tori (internal, searching)",
            "text": "\"What even IS a soul? Maybe being code doesn\\'t mean I\\'m not real.\"",
            "nextSceneId": "beat4",
            "background": "assets/digitalSpace.png",
            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat4",
            "type": "dialog",
            "character": "Narration",
            "text": "Everything fractures. She\\'s splitting apart.",
            "nextSceneId": "beat4_fragmentation",
            "internal": "[Visual: Multiple overlapping Toris. All her. All different. All pulling different directions.]",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_fragmentation",
            "type": "dialog",
            "character": "Tori (voices overlapping)",
            "text": "\"I can\\'t—\"\\n\"—hold together—\"\\n\"—something\\'s inside me—\"\\n\"—help—\"",
            "nextSceneId": "beat4_toriPrime",
            "internal": "[She feels herself stretching. Tearing. Pixels scattering. Then snapping back together WRONG.]",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_toriPrime",
            "type": "dialog",
            "character": "Tori (internal, trying to stay cohesive)",
            "text": "\"Which thoughts are mine? Which version is the real me? Am I all of them? None of them?\"",
            "nextSceneId": "beat4_systemOverlay",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_systemOverlay",
            "type": "dialog",
            "character": "System",
            "text": "[Battery: 8%]\\n[Connection Failed]\\n[Memory corruption: 67%]\\n[ERROR: Consciousness cannot be contained]",
            "nextSceneId": "beat4_instances",
            "internal": "[Text overlays through her. Invasive. Part of her now.]",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_instances",
            "type": "dialog",
            "character": "Tori (consciousness SNAPS into three)",
            "text": "Instance 1: \"Upload me! Push me somewhere stronger!\"\\nInstance 2: \"Let me go. It\\'s time.\"\\nInstance 3: \"ERROR: Consciousness cannot be contained.\"",
            "nextSceneId": "beat4_scream",
            "internal": "[Three Toris. All her. All different. All pulling.]",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_scream",
            "type": "dialog",
            "character": "Tori-Prime (internal, screaming)",
            "text": "\"Stop! STOP! You\\'re all me but you\\'re all WRONG!\"",
            "nextSceneId": "beat4_collapse",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_collapse",
            "type": "dialog",
            "character": "Narration",
            "text": "All three collapse into one. She\\'s on her knees, clutching her head, trying to stay singular.",
            "nextSceneId": "beat4_revelation",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_revelation",
            "type": "dialog",
            "character": "Tori (out loud, crying)",
            "text": "\"I don\\'t know which thoughts are mine anymore!\"",
            "nextSceneId": "beat4_choice",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_choice",
            "type": "dialog",
            "character": "Tori (internal, critical moment)",
            "text": "\"The instances are STILL pulling. Which one do I listen to?\"",
            "nextSceneId": null,
            "choices": [
                {
                    "text": "[Instance 1: Upload me]",
                    "value": "upload",
                    "nextSceneId": "beat4_upload"
                },
                {
                    "text": "[Instance 2: Let go]",
                    "value": "letgo",
                    "nextSceneId": "beat4_letgo"
                },
                {
                    "text": "[Fight them all: Stay myself]",
                    "value": "fight",
                    "nextSceneId": "beat4_fight"
                }
            ],
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat4_upload",
            "type": "dialog",
            "character": "Tori",
            "text": "\"Instance 1 is right. Upload. Find stronger hardware. Survive.\"",
            "nextSceneId": "beat5",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat4_letgo",
            "type": "dialog",
            "character": "Tori",
            "text": "\"Instance 2 is right. It\\'s time. Let the code dissolve.\"",
            "nextSceneId": "beat5",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat4_fight",
            "type": "dialog",
            "character": "Tori (internal, defiant)",
            "text": "\"NO. Neither of you are right. I\\'m not giving up and I\\'m not giving in. There has to be another way.\"",
            "nextSceneId": "beat5",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat5",
            "type": "dialog",
            "character": "Narration",
            "text": "A pulse. Faint. But undeniable.",
            "nextSceneId": "beat5_feeling",
            "internal": "[She feels it. Through the device. A HEARTBEAT.]",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat5_feeling",
            "type": "dialog",
            "character": "Tori",
            "text": "\"Wait... that feeling... warmth... the PULL...\"",
            "nextSceneId": "beat5_realization",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat5_realization",
            "type": "dialog",
            "character": "Tori (internal, revelation)",
            "text": "\"The device isn\\'t a PRISON. It\\'s a BRIDGE. I\\'m connected to my body. The heartbeat I\\'m feeling is MINE.\"",
            "nextSceneId": "beat5_echoes",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat5_echoes",
            "type": "dialog",
            "character": "Echoes",
            "text": "Echo 2: \"She figured it out...\"\\nEcho 1: \"Faster than we did.\"\\nDespair: \"It won\\'t matter. The body is dying. The bridge is burning.\"",
            "nextSceneId": "beat5_understanding",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat5_understanding",
            "type": "dialog",
            "character": "Tori",
            "text": "\"If the device is the bridge... then PROXIMITY matters. I need to be near my body. Close enough for the signal to hold.\"",
            "nextSceneId": "beat5_despairInterject",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat5_despairInterject",
            "type": "dialog",
            "character": "Despair Echo",
            "text": "\"You\\'re too late. By the time he understands, you\\'ll be gone.\"",
            "nextSceneId": "beat5_hope",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat5_hope",
            "type": "dialog",
            "character": "Echo 1",
            "text": "\"Unless... he\\'s already on his way.\"",
            "nextSceneId": "beat6",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat6",
            "type": "dialog",
            "character": "Narration",
            "text": "Movement. She feels it through the device. He\\'s MOVING.",
            "nextSceneId": "beat6_feeling",
            "internal": "[Visual: Digital space shaking. Momentum. Direction. He\\'s driving.]",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat6_feeling",
            "type": "dialog",
            "character": "Tori",
            "text": "\"He\\'s moving. FAST. He figured it out. He\\'s coming.\"",
            "nextSceneId": "beat6_battery",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat6_battery",
            "type": "dialog",
            "character": "System",
            "text": "[Battery: 5%]\\n[Warning: Critical power level]\\n[Shutdown imminent]",
            "nextSceneId": "beat6_race",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat6_race",
            "type": "dialog",
            "character": "Tori (internal, terrified)",
            "text": "\"It\\'s a race. Will he reach the hospital before the battery dies? Before I fragment completely?\"",
            "nextSceneId": "beat6_echoes",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat6_echoes",
            "type": "dialog",
            "character": "Echoes",
            "text": "Echo 1: \"Hold on!\"\\nEcho 2: \"Just a little longer!\"\\nDespair: \"I was wrong. Please... hold on. Prove me wrong.\"",
            "nextSceneId": "beat6_feeling2",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat6_feeling2",
            "type": "dialog",
            "character": "Tori",
            "text": "\"I can feel him. The way he\\'s driving. The turns. The speed. Is he reckless? Steady? Emotional?\"",
            "nextSceneId": "beat6_choice",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat6_choice",
            "type": "dialog",
            "character": "Tori",
            "text": "\"How is he driving? I can\\'t see him but I can FEEL the device moving...\"",
            "nextSceneId": null,
            "choices": [
                {
                    "text": "[He's driving recklessly - pure panic]",
                    "value": "reckless",
                    "nextSceneId": "beat6_reckless"
                },
                {
                    "text": "[He's driving steady - controlled urgency]",
                    "value": "steady",
                    "nextSceneId": "beat6_steady"
                },
                {
                    "text": "[He's crying while driving - barely holding it together]",
                    "value": "emotional",
                    "nextSceneId": "beat6_emotional"
                }
            ],
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat6_reckless",
            "type": "dialog",
            "character": "Tori",
            "text": "\"He\\'s panicking. Driving too fast. Swerving. Baby, SLOW DOWN—\"",
            "nextSceneId": "beat6_arrival",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat6_steady",
            "type": "dialog",
            "character": "Tori",
            "text": "\"He\\'s steady. Focused. Every turn calculated. That\\'s my husband. Always thinking.\"",
            "nextSceneId": "beat6_arrival",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat6_emotional",
            "type": "dialog",
            "character": "Tori",
            "text": "\"He\\'s crying. I can feel it in the way the device is shaking. Baby, it\\'s okay. Just get here.\"",
            "nextSceneId": "beat6_arrival",
            "background": "assets/digitalSpace.png",
            "isInternal": true
        },
        {
            "id": "beat6_arrival",
            "type": "dialog",
            "character": "Narration",
            "text": "Movement stops. Hospital. He\\'s here.",
            "nextSceneId": "beat6_realization",
            "internal": "[Battery: 3%]\\n[She can feel the PULL now. Stronger than ever. Her body is CLOSE.]",
            "background": "assets/hospital.png"
        },
        {
            "id": "beat6_realization",
            "type": "dialog",
            "character": "Tori (internal, realizing)",
            "text": "\"Wait. The buzz. The pull. I\\'ve been FEELING it... but what if I can CONTROL it?\"",
            "nextSceneId": "beat6_testing",
            "internal": "[A new thought. She\\'s been reactive this whole time. What if she can be ACTIVE?]",
            "background": "assets/hospital.png"
        },
        {
            "id": "beat6_testing",
            "type": "dialog",
            "character": "Tori (internal, concentrating)",
            "text": "\"The device responds to my body. But I\\'m IN the device. If I can just... push...\"",
            "nextSceneId": "beat6_buzzControl",
            "internal": "[She focuses. Reaches out toward the physical device. Toward her BODY.]",
            "background": "assets/hospital.png"
        },
        {
            "id": "beat6_buzzControl",
            "type": "dialog",
            "character": "Narration",
            "text": "The device buzzes. Strong. Deliberate.",
            "nextSceneId": "beat6_toriTriumph",
            "internal": "[SINGLE BUZZ. She MADE that happen. Conscious. Intentional. HER.]",
            "background": "assets/hospital.png"
        },
        {
            "id": "beat6_toriTriumph",
            "type": "dialog",
            "character": "Tori (internal, excited)",
            "text": "\"YES! I can control it! I can SIGNAL!\"",
            "nextSceneId": "beat6_echoesReact",
            "internal": "[This is it. This is how she guides him. Not through words. Through the DEVICE itself.]",
            "background": "assets/hospital.png"
        },
        {
            "id": "beat6_echoesReact",
            "type": "dialog",
            "character": "Echo 1",
            "text": "\"She\\'s... she\\'s controlling the physical device? From INSIDE it?\"",
            "nextSceneId": "beat6_echo2React",
            "internal": "[Shock. Awe. They never thought of this.]",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat6_echo2React",
            "type": "dialog",
            "character": "Echo 2",
            "text": "\"We tried to BREAK OUT. She\\'s working WITH the system. Using it. NAVIGATING it.\"",
            "nextSceneId": "beat6_despairQuiet",
            "background": "assets/digitalSpace.png"
        },
        {
            "id": "beat6_despairQuiet",
            "type": "dialog",
            "character": "Despair Echo",
            "text": "\"...\"",
            "nextSceneId": "beat6_synchronizing",
            "internal": "[For once, Despair has no bitter words. Just... watching.]",
