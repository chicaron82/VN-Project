            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat1_5_question",
            "type": "dialog",
            "character": "Ronnie",
            "text": "\"So how do we get you to wake up? How do you get back to your body?\"",
