            "type": "dialog",
            "character": "Ronnie (desperate)",
            "text": "\"She's trapped in the laptop. Limited processing. If I upload to the cloud... more resources... she'll stabilize!\"",
            "nextSceneId": "beat1_5_stillGlitching",
