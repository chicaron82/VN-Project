            "id": "beat3_echoesRespond",
            "type": "dialog",
            "character": "Echoes",
            "text": "Echo 1: \"It's getting worse.\"\\nEcho 2: \"The system's taking over.\"\\nDespair: \"You're becoming a passenger in your own existence.\"",
