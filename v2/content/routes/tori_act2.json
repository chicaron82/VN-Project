                "right": "assets/full-sprite-ronnie.webp",
                "highlight": "left"
            }
        },
        {
            "id": "beat1_5_soulLine",
            "type": "dialog",
            "character": "Tori",
            "text": "\"You can't upload a soul. I'm in the Tamagotchi.\"",
