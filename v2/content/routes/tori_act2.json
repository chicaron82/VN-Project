            "sprites": {
                "left": "assets/full-sprite-tori.webp",
                "right": "assets/full-sprite-ronnie.webp"
            }
        },
        {
            "id": "beat1_5_buzzing",
            "type": "dialog",
            "character": "Ronnie (realizing)",
            "text": "\"Wait... the buzzing. The Tamagotchi has been buzzing. And ONLY when I visit you at the hospital!\"",
