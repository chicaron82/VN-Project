        },
        {
            "id": "epilogue_chicharon",
            "type": "dialog",
            "character": "Tori (studying his face)",
            "text": "\"Those eyes...\"",
            "nextSceneId": "epilogue_chicharonRecognition",
            "internal": "[She traces his jawline. Something ancient stirring in her memory. A voice across timelines.]",
