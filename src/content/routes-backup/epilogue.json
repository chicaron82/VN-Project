        },
        {
            "id": "epilogue_ronnieJoke",
            "type": "dialog",
            "character": "Ronnie",
            "text": "\"Thought I'd try it out. It's getting colder out. Keeps my face warm 😜 Plus I'll look like Santa if I put the hat on.\"",
            "nextSceneId": "epilogue_realization",
            "background": "assets/apartment.png",
            "sprites": {
                "left": "assets/full-sprite-ronnie.webp",
                "right": "assets/full-sprite-tori.webp"
            }
        },
        {
            "id": "epilogue_realization",
            "type": "dialog",
            "character": "Tori (distant look)",
            "text": "\"You look... distinguished. Older. Like you've seen things...\"",
