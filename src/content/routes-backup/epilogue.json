            "background": "assets/apartment.png",
            "sprites": {
                "left": "assets/full-sprite-ronnie.webp",
                "right": "assets/full-sprite-tori.webp"
            }
        },
        {
            "id": "epilogue_connection",
            "type": "dialog",
            "character": "Tori",
            "text": "\"I feel like... I've seen this exact look before...\"",
            "nextSceneId": "epilogue_chicharon",
            "internal": "[FLASHBACK: The street bump. The Old Man reaching for her. Gray hair. Beard. Those same eyes. The BGA hoodie...]",
